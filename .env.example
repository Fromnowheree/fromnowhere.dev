# Copy to .env and fill in. .env is never committed. On a VPS it is read by compose (and by
# scripts/backup.sh, line by line); the app container gets only the variables compose.yml lists.

# --- The image (built by CI on a version tag, or by hand: Dockerfile; never built on the VPS) ---
# The image you loaded on the server, e.g. fromnowhere-web:0.1.0. Compose refuses to start without it.
APP_IMAGE=

# --- Database (compose.yml creates Postgres from these and builds DATABASE_URL) ---
# The superuser, for backups and maintenance only; the app never logs in with it.
POSTGRES_USER=fnw
# Generate with: openssl rand -hex 32. Compose refuses to start while it is empty.
POSTGRES_PASSWORD=
POSTGRES_DB=fnw
# The app's own login, `app`, which owns the site's database and nothing else (db/init/).
# Generate with: openssl rand -hex 32 (hex, so it is safe inside DATABASE_URL).
APP_DB_PASSWORD=
# Only needed when running outside compose (local development, compose.dev.yml):
DATABASE_URL=postgres://fnw:fnw@localhost:5432/fnw

# --- App ---
# Required. Generate with: openssl rand -hex 32. Final once the site is live: it also derives the
# contact form's signing keys and the provisioning token.
PAYLOAD_SECRET=
# Public URL of the site (the bare domain), used for canonical links, the sitemap and share cards.
# For development: http://localhost:3000
SITE_URL=https://fromnowhere.dev
# Fill an EMPTY database with the starting content (the four projects, their short links, the
# studio's words, About and Privacy, in English and Croatian) on start. It never overwrites: once
# any project exists it does nothing. For development, and once on the server's first start.
PAYLOAD_SEED=false
# The status check: every 5 minutes the server knocks on each published project's addresses and
# the board shows a running line whose address stops answering as Delayed. "off" stops it (the
# end-to-end tests do); anything else, or empty, keeps it on. It needs outbound HTTPS.
STATUS_CHECKS=on
# The first admin's e-mail. ./scripts/create-admin.sh creates the account with a generated
# password, printed once; nobody can claim the admin before that.
ADMIN_EMAIL=

# --- Caddy (HTTPS) ---
# The bare domain. The site is served here; www.<domain> redirects to it.
SITE_DOMAIN=fromnowhere.dev

# --- Backups (scripts/backup.sh, nightly from cron) ---
# The age PUBLIC key(s) backups are encrypted to, comma-separated (age1...). Required: without
# it the script refuses. Generate the key pair OFF the VPS (age-keygen -o backup-key.txt) and
# keep the private key where you keep your other keys; it never goes on the server.
BACKUP_RECIPIENT=
# Days to keep encrypted backups on the VPS.
BACKUP_KEEP_DAYS=30

# --- Visitor statistics (Umami, self-hosted; optional, off by default) ---
# Only with compose.stats.yml (COMPOSE_FILE=compose.yml:compose.stats.yml), which refuses to start
# Umami while the two secrets below are empty. Statistics also have to be switched on in the
# admin (Studio → Search and statistics); until both, the site loads no statistics script.
# Generate each with: openssl rand -hex 32
UMAMI_APP_SECRET=
# Password of Umami's own database login (it cannot open the site's database).
UMAMI_DB_PASSWORD=
# Subdomain for the statistics dashboard, e.g. stats.fromnowhere.dev (needs its own DNS record).
# Set it only after ./scripts/stats-admin.sh has replaced Umami's default admin password.
# Empty turns the dashboard off.
STATS_DOMAIN=
# Website ID from the Umami dashboard. The tracker is added to the site only while this and
# UMAMI_SCRIPT_URL are both set and the admin setting is on.
UMAMI_WEBSITE_ID=
# Caddy serves Umami's tracker here, on the site's own domain. Leave empty without statistics.
UMAMI_SCRIPT_URL=

# --- The contact form's mail account (send-only). Without all of these the form is not shown ---
# A mailbox that may only SEND, from its own address (e.g. website@fromnowhere.dev); never your
# own inbox. Messages go From CONTACT_FROM to CONTACT_TO, with Reply-To set to the visitor. The
# connection must be encrypted: 587 uses STARTTLS (required), 465 uses TLS from the start.
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=
CONTACT_SMTP_PASS=
CONTACT_FROM=
CONTACT_TO=

# --- E-mail for the admin (password resets). Without SMTP_HOST and SMTP_FROM, mail is only logged ---
# The connection must offer STARTTLS (or use port 465).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=

# --- Local development only ---
# Comma-separated LAN IPs of this machine, so you can open the dev server on a phone.
DEV_ALLOWED_ORIGINS=
