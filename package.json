{
  "name": "fromnowhere-web",
  "version": "0.1.0",
  "private": true,
  "description": "fromnowhere.dev: the Fromnowhere studio site and its editor. Next.js and Payload CMS.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "capture:windows": "tsx scripts/capture-windows.ts",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:mail": "cross-env NODE_OPTIONS=--no-deprecation NODE_EXTRA_CA_CERTS=.dev/mail/ca.crt next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/email-nodemailer": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/translations": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "altcha": "3.5.0",
    "altcha-lib": "2.8.0",
    "cross-env": "^10.1.0",
    "dotenv": "18.0.9",
    "graphql": "^16.8.1",
    "next": "16.4.6",
    "next-intl": "4.14.9",
    "nodemailer": "10.3.1",
    "payload": "3.92.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.6",
    "pg": "8.23.1",
    "prettier": "^3.4.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=26.13.0",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.20.0"
}
